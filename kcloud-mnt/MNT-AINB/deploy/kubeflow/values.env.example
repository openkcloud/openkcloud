# install.sh 설정값 예시 — 복사해서 values.env 로 쓰고 값을 채운다 (values.env 는 저장소에 올리지 않는다)

# 포털을 여는 도메인 (Ingress host)
OKC_HOST=okc-ai.example.org
# 브라우저가 여는 주소. 비우면 https://$OKC_HOST
PUBLIC_BASE_URL=
CORS_ORIGINS=

# 로그인 계정: 아이디:비밀번호:역할 (역할 admin/user), 콤마로 구분. IAM 연동 전 임시
CMP_USERS='admin:CHANGE-ME:admin,user:CHANGE-ME:user'
# 세션 서명 키. 비우면 설치 때 무작위로 만든다
CMP_SESSION_SECRET=

# 가속기 자원 이름: GPU nvidia.com/gpu, Rebellions rebellions.ai/ATOM, Furiosa RNGD furiosa.ai/rngd
ACCEL_RESOURCE=nvidia.com/gpu
# NVIDIA 런타임클래스가 따로 있는 클러스터만 nvidia. 보통은 비운다
GPU_RUNTIME_CLASS=

# 이미지 주소 (사설 레지스트리에 올렸으면 그 주소로)
OKC_BACKEND_IMAGE=okc-ai-backend:0.2
OKC_PORTAL_IMAGE=okc-ai-portal:0.2

# 이 클러스터에는 절대 설치하지 않는다 (예: 개발 PC 운영 클러스터 API 주소)
PROTECT_SERVER=
