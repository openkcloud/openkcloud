# MNT-IAAS 로컬 설정 — cp config.env.example config.env
OS_AUTH_URL=https://keystone-api.kcloud.cluster.local/v3
OS_USERNAME=
OS_PASSWORD=
OS_PROJECT_NAME=admin
CORE_API_BASE=http://localhost:8000
TEMPORAL_API_BASE=localhost:7233

# 브라우저(로컬 dev 프론트)에서 직접 호출할 때 필요. 게이트웨이(single-origin) 구성이면 비워도 된다.
CORS_ORIGINS=http://localhost:3000
