# 개발 서버 Keycloak(docker-compose.yaml) 설정 — cp .env.example .env 후 비밀번호 입력(.env 는 git 제외)
# 접속 주소(토큰 발급자). 접속하는 PC 의 hosts 에 '172.30.1.200 keycloak.dev.okestro' 등록 필요
KC_HOSTNAME=http://keycloak.dev.okestro:8080
# keycloak_db.sql 로 만든 DB 계정 keycloak 의 비밀번호. 특수문자가 있으면 작은따옴표로 감싼다
KC_DB_PASSWORD='CHANGE_ME'
# 첫 관리자(admin, 임시) 비밀번호
KC_ADMIN_PASSWORD='CHANGE_ME'
